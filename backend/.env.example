# ---- LLM（OpenAI 兼容接口）----
LLM_BASE_URL=https://your-llm-endpoint.example.com/api/v3
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-id

# 可选：轻量模型（意图路由 / 标题）；不填则回退到上面主模型
# LLM_FAST_BASE_URL=
# LLM_FAST_API_KEY=
# LLM_FAST_MODEL=

# ---- LangSmith（可观测：图节点 / LLM / 工具调用）----
# 控制台 https://smith.langchain.com/ 创建 API Key；tracing 需 true 且 key 非空
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-demo
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# ---- 文生图（SiliconFlow / 火山方舟 / OpenAI 兼容；改 env 即可切换）----
# SiliconFlow 示例：
IMAGE_GEN_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_GEN_API_KEY=  # 空且 base 含 siliconflow 时回退 EMBEDDING_API_KEY
IMAGE_GEN_MODEL=Kwai-Kolors/Kolors
IMAGE_GEN_SIZE=1024x1024
# IMAGE_GEN_PROVIDER=auto
# IMAGE_GEN_NUM_INFERENCE_STEPS=20
# IMAGE_GEN_GUIDANCE_SCALE=7.5
# IMAGE_GEN_TIMEOUT_SEC=120

# 火山方舟示例（Seedream；provider=auto 会识别 volces.com）：
# IMAGE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# IMAGE_GEN_API_KEY=你的_ARK_API_KEY
# IMAGE_GEN_MODEL=doubao-seedream-5-0-lite-260128
# IMAGE_GEN_SIZE=1K
# IMAGE_GEN_PROVIDER=ark
# IMAGE_GEN_WATERMARK=false
# IMAGE_GEN_OUTPUT_FORMAT=png

# ---- 图像编辑（与文生图独立；改 env 即可切换硅基 / 火山）----
IMAGE_EDIT_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_EDIT_API_KEY=  # 空且 base 含 siliconflow 时回退 EMBEDDING_API_KEY
IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509
# IMAGE_EDIT_PROVIDER=auto
# IMAGE_EDIT_NUM_INFERENCE_STEPS=20
# IMAGE_EDIT_CFG=4
# IMAGE_EDIT_TIMEOUT_SEC=120
# 火山方舟示例（Seedream 图编；单图 string / 多图 array，代码内自动组装）：
# IMAGE_EDIT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# IMAGE_EDIT_API_KEY=你的_ARK_API_KEY
# IMAGE_EDIT_MODEL=doubao-seedream-5-0-lite-260128
# IMAGE_EDIT_SIZE=1K
# IMAGE_EDIT_PROVIDER=ark
# IMAGE_EDIT_WATERMARK=false
# IMAGE_EDIT_OUTPUT_FORMAT=png

# ---- 录音识别（SiliconFlow Qwen3-Omni chat/completions + audio_url）----
ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=  # 空且 base 含 siliconflow 时回退 EMBEDDING_API_KEY / IMAGE_EDIT_API_KEY
ASR_MODEL=Qwen/Qwen3-Omni-30B-A3B-Thinking
# ASR_TIMEOUT_SEC=600

# ---- 声音克隆 TTS（SiliconFlow /audio/speech + references）----
# TTS_BASE_URL=  # 空则回退 ASR_BASE_URL
# TTS_API_KEY=  # 空且 base 含 siliconflow 时回退 EMBEDDING_API_KEY / ASR_API_KEY
TTS_DEFAULT_MODEL=fnlp/MOSS-TTSD-v0.5
# TTS_TIMEOUT_SEC=180
# 页面可选模型：fnlp/MOSS-TTSD-v0.5、FunAudioLLM/CosyVoice2-0.5B

# ---- Agent 安全闸（防死循环）----
# GRAPH_RECURSION_LIMIT=28
# TOOL_MAX_TOTAL_CALLS=12
# TOOL_MAX_CALLS_PER_NAME=3
# TOOL_MAX_CONSECUTIVE_FAILURES=2

# ---- LLM 上下文裁剪（喂主模型前；不改 checkpoint / 前端历史）----
# LLM_CONTEXT_TRIM_ENABLED=true
# LLM_CONTEXT_MAX_USER_TURNS=12
# LLM_CONTEXT_TOOL_MAX_CHARS=6000
# LLM_CONTEXT_RECENT_TOOL_MAX_CHARS=12000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=langgraph_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
# POSTGRES_POOL_MIN=2
# POSTGRES_POOL_MAX=40
# POSTGRES_COMMAND_TIMEOUT_SEC=30
# 池耗尽取连接超时（秒）；闲置连接回收（秒，0=不回收）
# POSTGRES_POOL_ACQUIRE_TIMEOUT_SEC=10
# POSTGRES_POOL_MAX_INACTIVE_SEC=300
# Checkpointer 池；MAX=0 表示对齐 MAX_CONCURRENT_RUNS
# POSTGRES_CHECKPOINT_POOL_MIN=1
# POSTGRES_CHECKPOINT_POOL_MAX=0
# POSTGRES_CHECKPOINT_POOL_TIMEOUT_SEC=10
# POSTGRES_CHECKPOINT_POOL_MAX_LIFETIME_SEC=3600
# POSTGRES_CHECKPOINT_POOL_MAX_IDLE_SEC=600

# ---- 鉴权（JWT + Refresh Cookie）----
# 生产务必换成足够长的随机串
JWT_SECRET=please-change-me-to-a-long-random-string
# JWT_ACCESS_EXPIRE_MINUTES=30
# JWT_REFRESH_EXPIRE_DAYS=14
# 前端 Vite 地址（逗号分隔）；Cookie 鉴权不能用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 首次启动若库中无管理员且密码非空，则创建管理员
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_EMAIL=admin@localhost
# 走 Vite 代理同站时用 lax；纯跨域需 none 且 AUTH_COOKIE_SECURE=true（HTTPS）
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_NAME=refresh_token

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name

# ---- 阿里云实时语音（NLS；前端 Token + 直连 WebSocket）----
# 控制台：https://nls-portal.console.aliyun.com/applist
NLS_APP_KEY=your-nls-app-key
# 空则回退上面的 OSS_ACCESS_KEY_*（需具备 nls:CreateToken 权限）
# NLS_ACCESS_KEY_ID=
# NLS_ACCESS_KEY_SECRET=
# NLS_GATEWAY_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# ---- Embedding（api=硅基等 /v1/embeddings；local=本机 BGE-M3）----
# 未写 EMBEDDING_PROVIDER 时：配齐 base+key+model 则自动走 api
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=your-siliconflow-api-key
# 文档/RAG 用文本版；图文混嵌再用 Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 须为 .../v1（不要带 /chat/completions 或 /embeddings）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 输出维度；须与 Milvus dense 一致。换模型/维度后需删库重建并重新入库
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_TIMEOUT_SEC=120
# 本地模式（需额外: pip install -r requirements-local-models.txt）：
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cuda
# 启动时后台预热（api 模式只打一次轻量探测，不会加载 torch）
# WARMUP_EMBEDDING=1

# ---- Rerank（api=/v1/rerank；local=本机 CrossEncoder）----
RERANK_ENABLED=true
# 空则跟 EMBEDDING_PROVIDER
RERANK_PROVIDER=api
# 空则回退 EMBEDDING_BASE_URL / EMBEDDING_API_KEY
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# RERANK_INSTRUCTION=
# RERANK_TIMEOUT_SEC=120
# 本地模式示例：
# RERANK_PROVIDER=local
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_DEVICE=cuda
# RERANK_RECALL_MULTIPLIER=4
# RERANK_MAX_RECALL=50
# 绝对阈值一般不用（空=关闭）
# RERANK_SCORE_THRESHOLD=
# 相对过滤：保留 score >= top1 - margin
RERANK_RELATIVE_FILTER=true
RERANK_SCORE_MARGIN=0.4

# L3 命中后按 parent_chunk_id 回查 L2 给 LLM（需用新切块参数重新入库）
RAG_EXPAND_TO_L2=true

# ---- Milvus ----
# 本地开发可用 Lite：MILVUS_URI=./milvus_demo.db
# 生产务必改为远程 Standalone（多实例/高并发不可用 Lite）
# 裸机 / 本机 compose：http://127.0.0.1:19530
# docker-compose.prod.yml 内 API 容器会被覆盖为 http://milvus:19530
# MILVUS_URI=http://127.0.0.1:19530
MILVUS_URI=./milvus_demo.db
# MILVUS_TOKEN=

# ---- 生产部署骨架 ----
# Docker 一键：docker compose -f docker-compose.prod.yml up -d --build
# 关键差异见 deploy/env.prod.example；Nginx 见 deploy/nginx*.conf；systemd 见 deploy/systemd/

# ---- 文档工作区临时 RAG ----
# 滑动过期天数：上传/打开/对话会续期；过期后 GC 硬删 OSS+PG+Milvus
# WORKSPACE_TTL_DAYS=10
# GC 轮询间隔（秒）；0=关闭后台清理
# WORKSPACE_GC_INTERVAL_SEC=3600
# 每轮最多清理工作区数
# WORKSPACE_GC_BATCH_SIZE=20

# ---- 销售分析工作区（仅 .xlsx → 结构化表；无向量）----
# SALES_WORKSPACE_TTL_DAYS=10
# SALES_WORKSPACE_GC_INTERVAL_SEC=3600
# SALES_WORKSPACE_GC_BATCH_SIZE=20
# SALES_MAX_FILE_BYTES=20971520
# SALES_MAX_SHEETS=20
# SALES_MAX_ROWS_PER_SHEET=50000
# SALES_QUERY_DEFAULT_LIMIT=200
# SALES_QUERY_MAX_LIMIT=2000
