# 生产环境相对 backend/.env.example 的关键差异（合并进 backend/.env）
# Docker Compose（docker-compose.prod.yml）会再覆盖 POSTGRES_HOST / MILVUS_URI

# ---- 域名与 Cookie（Nginx 同源反代）----
# 填真实前端 Origin，不能用 *
CORS_ORIGINS=https://your.domain.example
AUTH_COOKIE_SAMESITE=lax
# 上 HTTPS 后改为 true
AUTH_COOKIE_SECURE=true

# ---- 密钥（必须更换）----
JWT_SECRET=replace-with-a-long-random-string
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-me
AUTH_ADMIN_EMAIL=admin@your.domain.example

# ---- Postgres ----
# compose 内：主机名由 compose environment 设为 postgres，这里可留占位
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=langgraph_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-strong-db-password

# 裸机 systemd：改成 127.0.0.1 或云 RDS 地址
# POSTGRES_HOST=127.0.0.1

# ---- Milvus（禁止再用 ./milvus_demo.db）----
MILVUS_URI=http://milvus:19530
# 裸机 / 宿主机访问本机 compose Milvus：
# MILVUS_URI=http://127.0.0.1:19530

# ---- 阿里云 OSS / LLM / Embedding：沿用 .env.example 填齐 ----

# ---- Compose 可选（写在项目根 .env，供 docker compose 变量替换）----
# POSTGRES_PASSWORD=replace-strong-db-password
# HTTP_PORT=80
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=change-me-not-default

# ---- LangSmith（生产建议单独项目名；密钥勿进镜像）----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langgraph-demo-prod
